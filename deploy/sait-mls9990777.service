[Unit]
Description=Landing site mls9990777 with YooKassa payments
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/projects/sait-mls9990777
EnvironmentFile=/opt/projects/sait-mls9990777/.env
ExecStart=/opt/projects/sait-mls9990777/.venv/bin/python -m server.app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
