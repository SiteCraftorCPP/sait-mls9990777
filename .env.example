# Публичный URL сайта (без слэша на конце)
SITE_URL=https://example.com

# ЮKassa — те же Shop ID и Secret Key, что для магазина (не PAYMENT_PROVIDER_TOKEN бота)
YOOKASSA_SHOP_ID=1427327
YOOKASSA_SECRET_KEY=

# Цена в рублях
COURSE_PRICE=100.00

# Чек 54-ФЗ: 1=ОСН, 2=УСН доход, 3=УСН доход-расход, 4=ЕНВД, 5=ЕСХН, 6=Патент
YOOKASSA_TAX_SYSTEM_CODE=2
YOOKASSA_VAT_CODE=1

# Ссылка на закрытый канал после оплаты
COURSE_CHANNEL_URL=https://t.me/+JARHvPSqchhjZjBi

# Порт внутреннего сервера (nginx проксирует сюда)
APP_HOST=127.0.0.1
APP_PORT=8090
